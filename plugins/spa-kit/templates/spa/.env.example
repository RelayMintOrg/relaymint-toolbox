# Absolute origin of the deployed site. Canonicals, sitemap entries and JSON-LD
# @id values all derive from it, so a wrong value silently breaks indexing.
NEXT_PUBLIC_SITE_URL=__SPA_URL__

# ---- Built-in chatbot (only when the brief has chatbot.backend = "builtin") ----
# Server-side only: none of these has a NEXT_PUBLIC_ prefix, so none can reach the
# browser. Set them in the host's environment, never in the repository.
#
# Which provider answers. "chat-completions" speaks the widely implemented
# chat-completions JSON format, so it covers hosted services and self-hosted
# model servers. Unset, the chat route answers 503 and the widget says the
# assistant is unavailable.
# CHAT_PROVIDER=chat-completions
# CHAT_BASE_URL=https://llm.example.com/v1
# CHAT_MODEL=your-model-name
# CHAT_API_KEY=
#
# Limits (defaults shown).
# CHAT_MAX_INPUT_CHARS=800
# CHAT_MAX_OUTPUT_TOKENS=400
# CHAT_TIMEOUT_MS=20000
# CHAT_RATE_LIMIT_MAX=20
# CHAT_RATE_LIMIT_WINDOW_SECONDS=60
# Header carrying the client address, as set by your platform's proxy.
# CHAT_CLIENT_IP_HEADER=x-forwarded-for

# ---- RelayMint chatbot (only when the brief has chatbot.backend = "relaymint") ----
# Public by design and inlined at build time: changing them needs a rebuild.
# NEXT_PUBLIC_RELAYMINT_WIDGET_ORIGIN=https://app.example.com
# NEXT_PUBLIC_RELAYMINT_WIDGET_KEY=pk_live_...
